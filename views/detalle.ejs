<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title><%= producto.nombre %></title>
</head>

<body>

    <h1><%= producto.nombre %></h1>

    <img src="<%= producto.imagen %>" alt="<%= producto.nombre %>">

    <p><%= producto.descripcion %></p>

    <p>Precio: $<%= producto.precio %></p>

    <p>Categoría: <%= producto.categoria %></p>

    <p>Stock: <%= producto.stock %></p>

</body>
</html>